{
  "version": 1,
  "runtime": "go",
  "authentication": {
    "transport": "same-origin HttpOnly MP_SESSION cookie",
    "csrf": "MP_CSRF cookie plus X-CSRF-Token for unsafe requests",
    "browserReadableTokens": false
  },
  "rooms": {
    "list": {
      "method": "GET",
      "path": "/api/rooms",
      "privateRoomsDiscoverable": true,
      "accessField": "accessGranted"
    },
    "verify": {
      "method": "POST",
      "path": "/api/rooms/{roomId}/verify",
      "body": { "password": "string" },
      "response": { "roomId": "string", "accessGranted": true, "expiresAt": "unix-ms" },
      "setsCookie": "MP_ROOM_ACCESS"
    },
    "management": {
      "method": "PUT",
      "path": "/api/rooms/{roomId}",
      "body": { "name": "string", "isPrivate": "boolean", "password": "string", "keepExistingPassword": "boolean" },
      "authorized": ["room owner", "platform administrator"]
    }
  },
  "websocket": {
    "path": "/ws?room-id={roomId}",
    "authentication": "session and room access cookies are sent by the browser",
    "noSessionTokenField": true
  },
  "resources": {
    "authorization": "cookie-based",
    "queryToken": false
  }
}
